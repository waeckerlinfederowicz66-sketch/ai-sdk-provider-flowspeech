{
  "name": "ai-sdk-provider-flowspeech",
  "version": "0.2.0",
  "description": "FlowSpeech public API v1 asynchronous text-to-speech provider for the Vercel AI SDK.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "dist/*.js.map",
    "dist/*.d.ts.map",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check:runtime": "node scripts/check-runtime.mjs",
    "test:runtime": "node --test tests/runtime-guard.mjs",
    "pretest": "npm run check:runtime",
    "prebuild": "npm run check:runtime",
    "pretypecheck": "npm run check:runtime",
    "pretest:dist": "npm run check:runtime",
    "preaudit:package": "npm run check:runtime",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run check:runtime && npm run test:runtime && npm test && npm run typecheck && npm run build && npm run test:dist",
    "test:dist": "node --test tests/artifact-smoke.mjs",
    "prepack": "npm run build && npm run test:dist",
    "audit:package": "node tests/package-audit.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waeckerlinfederowicz66-sketch/ai-sdk-provider-flowspeech.git"
  },
  "homepage": "https://flowspeech.io/",
  "bugs": {
    "url": "https://github.com/waeckerlinfederowicz66-sketch/ai-sdk-provider-flowspeech/issues"
  },
  "keywords": [
    "ai-sdk",
    "vercel-ai-sdk",
    "flowspeech",
    "text-to-speech",
    "tts",
    "speech"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.7",
    "@ai-sdk/provider-utils": "^5.0.27"
  },
  "devDependencies": {
    "ai": "^7.0.68",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@types/node": "24.13.3"
  }
}
